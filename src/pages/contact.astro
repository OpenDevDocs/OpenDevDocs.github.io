---
import MainLayout from "../layouts/MainLayout.astro";
import { CONTACT_EMAIL, getSiteName, GITHUB_ISSUES_URL, GITHUB_REPO_URL } from "../data/data";

// Prefilled GitHub issue links, so a report lands with the details we need
const newIssue = (title: string, body: string) =>
    `${GITHUB_ISSUES_URL}/new?title=${encodeURIComponent(title)}&body=${encodeURIComponent(body)}`;
const reportMistakeUrl = newIssue("Mistake in: <page title>", "Page URL:\n\nWhat is wrong:\n\nWhat it should say (if you know):\n");
const suggestTopicUrl = newIssue("Topic suggestion: <topic>", "Course:\n\nWhat the lesson should cover:\n");
---

<style is:inline>
    .contact-card {
        padding: 1.5rem;
        border-radius: 1rem;
        transition: all 0.3s ease;
    }

    .contact-card:hover {
        transform: translateY(-5px);
        box-shadow: 0 20px 40px -12px rgba(0, 0, 0, 0.15);
    }

    .contact-card .icon-wrapper {
        width: 3.5rem;
        height: 3.5rem;
        border-radius: 1rem;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.25rem;
    }
</style>

<MainLayout
    pageTitle={`Contact Us - ${getSiteName()}`}
    description={`How to reach ${getSiteName()}: report a mistake in a lesson, suggest a topic, or ask a question.`}
    seoImagePath="">

    <!-- Hero Section -->
    <header class="pt-24 py-16 px-6 bg-gradient-to-br from-purple-50 to-blue-50 dark:from-gray-900 dark:to-gray-800 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-purple-300 dark:bg-purple-900 rounded-full -translate-y-32 translate-x-32 opacity-30 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-blue-300 dark:bg-blue-900 rounded-full translate-y-32 -translate-x-32 opacity-30 blur-3xl"></div>

        <div class="container mx-auto relative z-10">
            <div class="max-w-3xl mx-auto text-center animate-on-scroll">
                <h1 class="text-4xl md:text-5xl font-bold mb-6">
                    <span class="block">Get in</span>
                    <span class="gradient-text">Touch With Us</span>
                </h1>
                <p class="text-xl text-gray-600 dark:text-gray-300">
                    Found a mistake, want a topic covered, or have a question about the site? Use whichever channel below fits best.
                </p>
            </div>
        </div>
    </header>

    <!-- Contact Channels -->
    <section class="py-16 px-6 bg-white dark:bg-gray-800">
        <div class="container mx-auto max-w-5xl">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                <div class="contact-card bg-gray-50 dark:bg-gray-900">
                    <div class="icon-wrapper gradient-bg text-white mb-4">
                        <i class="fas fa-bug"></i>
                    </div>
                    <h2 class="text-lg font-bold mb-2">Report a Mistake</h2>
                    <p class="text-gray-600 dark:text-gray-300 text-sm mb-4">Wrong code, an outdated command or a typo? Open an issue with the page URL and what needs fixing.</p>
                    <a href={reportMistakeUrl} rel="noopener" class="text-purple-600 dark:text-purple-400 font-medium hover:underline">
                        Open an issue on GitHub <i class="fas fa-arrow-right ml-1"></i>
                    </a>
                </div>

                <div class="contact-card bg-gray-50 dark:bg-gray-900">
                    <div class="icon-wrapper bg-green-500 text-white mb-4">
                        <i class="fas fa-lightbulb"></i>
                    </div>
                    <h2 class="text-lg font-bold mb-2">Suggest a Topic</h2>
                    <p class="text-gray-600 dark:text-gray-300 text-sm mb-4">Tell us which lesson or course you would like to see next.</p>
                    <a href={suggestTopicUrl} rel="noopener" class="text-purple-600 dark:text-purple-400 font-medium hover:underline">
                        Suggest it on GitHub <i class="fas fa-arrow-right ml-1"></i>
                    </a>
                </div>

                {CONTACT_EMAIL && (
                    <div class="contact-card bg-gray-50 dark:bg-gray-900">
                        <div class="icon-wrapper bg-blue-500 text-white mb-4">
                            <i class="fas fa-envelope"></i>
                        </div>
                        <h2 class="text-lg font-bold mb-2">Email Us</h2>
                        <p class="text-gray-600 dark:text-gray-300 text-sm mb-4">For anything that should not be public, including privacy requests.</p>
                        <a href={`mailto:${CONTACT_EMAIL}`} class="text-purple-600 dark:text-purple-400 font-medium hover:underline">
                            {CONTACT_EMAIL}
                        </a>
                    </div>
                )}

                <div class="contact-card bg-gray-50 dark:bg-gray-900">
                    <div class="icon-wrapper bg-gray-800 text-white mb-4">
                        <i class="fab fa-github"></i>
                    </div>
                    <h2 class="text-lg font-bold mb-2">Contribute</h2>
                    <p class="text-gray-600 dark:text-gray-300 text-sm mb-4">Want to fix it yourself or write a lesson? The whole site is on GitHub.</p>
                    <a href="/contribute" class="text-purple-600 dark:text-purple-400 font-medium hover:underline">
                        How to contribute <i class="fas fa-arrow-right ml-1"></i>
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- Before you write -->
    <section class="py-16 px-6 bg-gray-50 dark:bg-gray-900">
        <div class="container mx-auto max-w-3xl">
            <h2 class="text-2xl font-bold mb-4">Before You Write</h2>
            <ul class="space-y-3 text-gray-700 dark:text-gray-300">
                <li><i class="fas fa-check text-green-500 mr-2"></i>Include the link to the page you are writing about.</li>
                <li><i class="fas fa-check text-green-500 mr-2"></i>For code problems, say which version of the language or framework you are using.</li>
                <li><i class="fas fa-check text-green-500 mr-2"></i>GitHub issues are public, so do not post passwords, keys or other private details there.</li>
                <li><i class="fas fa-check text-green-500 mr-2"></i>Questions about your data are answered in our <a href="/privacy-policy" class="text-purple-600 dark:text-purple-400 hover:underline">privacy policy</a>.</li>
            </ul>
            <p class="mt-6 text-gray-600 dark:text-gray-300">You can browse existing reports in the <a href={GITHUB_REPO_URL} rel="noopener" class="text-purple-600 dark:text-purple-400 hover:underline">site's GitHub repository</a>.</p>
        </div>
    </section>
</MainLayout>
