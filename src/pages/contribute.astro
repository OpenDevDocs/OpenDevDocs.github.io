---
import MainLayout from "../layouts/MainLayout.astro";
import { getSiteName, GITHUB_ISSUES_URL, GITHUB_REPO_URL } from "../data/data";

const exampleFrontmatter = `---
publishDate: 2026-03-12T09:19
title: Arrow Functions
slug: arrow-functions
metadescription: "Write shorter functions with arrow syntax: when to use them and when not to."
updateDate: 2026-03-12T09:19
author: ['your-author-id']
level: 2
tags: ['functions', 'es6']
course: javascript
---`;

const steps = [
    {
        title: "Pick or propose a topic",
        text: "Check the course syllabus for a topic that has no lesson yet, or open an issue to propose a new one, so two people do not write the same lesson.",
    },
    {
        title: "Fork the repository",
        text: "Fork the site's GitHub repository and create a branch for your change.",
    },
    {
        title: "Write the lesson",
        text: "Add a Markdown file under src/content/courses/<course>/. Explain one idea, show working code, and finish with a complete code example.",
    },
    {
        title: "Open a pull request",
        text: "Describe what the lesson covers and which version of the technology it targets. Review comments arrive on the pull request.",
    },
];
---

<MainLayout
    pageTitle={`Contribute - ${getSiteName()}`}
    description={`How to fix mistakes, suggest topics, or write lessons for ${getSiteName()} through GitHub.`}
    seoImagePath=""
>
    <!-- Hero Section -->
    <header class="pt-24 py-16 px-6 bg-gradient-to-br from-purple-50 to-blue-50 dark:from-gray-900 dark:to-gray-800 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-purple-300 dark:bg-purple-900 rounded-full -translate-y-32 translate-x-32 opacity-30 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-blue-300 dark:bg-blue-900 rounded-full translate-y-32 -translate-x-32 opacity-30 blur-3xl"></div>

        <div class="container mx-auto relative z-10">
            <div class="max-w-4xl mx-auto text-center animate-on-scroll">
                <h1 class="text-4xl md:text-5xl font-bold mb-6">
                    <span class="block">Share Your</span>
                    <span class="gradient-text">Coding Knowledge</span>
                </h1>
                <p class="text-xl text-gray-600 dark:text-gray-300 mb-8 max-w-3xl mx-auto">
                    {getSiteName()} is written in the open on GitHub. You can report a mistake, suggest a topic, or write a whole lesson.
                </p>
                <div class="flex flex-col sm:flex-row justify-center gap-4">
                    <a href={GITHUB_REPO_URL} rel="noopener" class="px-8 py-3 gradient-bg text-white font-medium rounded-full hover:opacity-90 transition-opacity shadow-lg">
                        <i class="fab fa-github mr-2"></i>View the Repository
                    </a>
                    <a href="#guidelines" class="px-8 py-3 bg-white dark:bg-gray-800 border-2 border-gray-300 dark:border-gray-700 font-medium rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">
                        Read Guidelines
                    </a>
                </div>
            </div>
        </div>
    </header>

    <!-- Ways to help -->
    <section class="py-16 px-6 bg-white dark:bg-gray-800">
        <div class="container mx-auto max-w-5xl">
            <h2 class="text-3xl font-bold text-center mb-10">Ways to <span class="gradient-text">Help</span></h2>
            <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
                <div class="rounded-2xl bg-gray-50 dark:bg-gray-900 p-6">
                    <i class="fas fa-bug text-2xl text-purple-500 mb-4"></i>
                    <h3 class="text-xl font-bold mb-2">Report a Mistake</h3>
                    <p class="text-gray-600 dark:text-gray-300 mb-4">The quickest help: tell us which page is wrong and why.</p>
                    <a href={GITHUB_ISSUES_URL} rel="noopener" class="text-purple-600 dark:text-purple-400 font-medium hover:underline">Open an issue</a>
                </div>
                <div class="rounded-2xl bg-gray-50 dark:bg-gray-900 p-6">
                    <i class="fas fa-lightbulb text-2xl text-green-500 mb-4"></i>
                    <h3 class="text-xl font-bold mb-2">Suggest a Topic</h3>
                    <p class="text-gray-600 dark:text-gray-300 mb-4">Missing a lesson you needed? Ask for it.</p>
                    <a href={GITHUB_ISSUES_URL} rel="noopener" class="text-purple-600 dark:text-purple-400 font-medium hover:underline">Suggest a topic</a>
                </div>
                <div class="rounded-2xl bg-gray-50 dark:bg-gray-900 p-6">
                    <i class="fas fa-pen-nib text-2xl text-blue-500 mb-4"></i>
                    <h3 class="text-xl font-bold mb-2">Write a Lesson</h3>
                    <p class="text-gray-600 dark:text-gray-300 mb-4">Add or improve a lesson with a pull request.</p>
                    <a href="#steps" class="text-purple-600 dark:text-purple-400 font-medium hover:underline">See the steps</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Steps -->
    <section id="steps" class="py-16 px-6 bg-gray-50 dark:bg-gray-900">
        <div class="container mx-auto max-w-4xl">
            <h2 class="text-3xl font-bold text-center mb-10">Writing a <span class="gradient-text">Lesson</span></h2>
            <ol class="space-y-6">
                {steps.map((step, index) => (
                    <li class="flex items-start bg-white dark:bg-gray-800 rounded-2xl p-6 shadow">
                        <span class="flex-shrink-0 w-10 h-10 gradient-bg rounded-full flex items-center justify-center mr-4 text-white font-bold">{index + 1}</span>
                        <div>
                            <h3 class="text-xl font-bold mb-1">{step.title}</h3>
                            <p class="text-gray-600 dark:text-gray-300">{step.text}</p>
                        </div>
                    </li>
                ))}
            </ol>

            <h3 class="text-xl font-bold mt-12 mb-3">Lesson front matter</h3>
            <p class="text-gray-600 dark:text-gray-300 mb-4">Each lesson file starts with this block. <code>level</code> is 1 (Beginner) to 4 (Expert), and a value containing ": " must be quoted.</p>
            <pre class="bg-gray-950 text-green-300 text-sm rounded-xl p-6 overflow-x-auto"><code>{exampleFrontmatter}</code></pre>
        </div>
    </section>

    <!-- Guidelines Section -->
    <section id="guidelines" class="py-16 px-6 bg-white dark:bg-gray-800">
        <div class="container mx-auto max-w-4xl">
            <h2 class="text-3xl font-bold text-center mb-10">Contribution <span class="gradient-text">Guidelines</span></h2>
            <ul class="space-y-3 text-gray-700 dark:text-gray-300">
                <li><i class="fas fa-check-circle text-green-500 mr-2"></i>Write original work. Do not copy text from documentation, books or other sites; link to them instead.</li>
                <li><i class="fas fa-check-circle text-green-500 mr-2"></i>Name the version you are teaching and check commands and APIs against its official documentation.</li>
                <li><i class="fas fa-check-circle text-green-500 mr-2"></i>Run every code example before you submit it.</li>
                <li><i class="fas fa-check-circle text-green-500 mr-2"></i>Keep one idea per lesson and use headings so readers can scan it.</li>
                <li><i class="fas fa-check-circle text-green-500 mr-2"></i>Never include real API keys, passwords or personal data, even as examples.</li>
                <li><i class="fas fa-check-circle text-green-500 mr-2"></i>By contributing you agree that your work is published under the site's <a href="/terms-conditions" class="text-purple-600 dark:text-purple-400 hover:underline">terms</a>.</li>
            </ul>
        </div>
    </section>
</MainLayout>
