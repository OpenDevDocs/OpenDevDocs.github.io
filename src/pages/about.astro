---
import MainLayout from "../layouts/MainLayout.astro";
import AuthorCard from "../components/AuthorCard.astro";
import { authors } from "../data/authors";
import { courses } from "../data/courses";
import { getSiteName, GITHUB_ISSUES_URL, GITHUB_REPO_URL } from "../data/data";
import { getCourseResources, getPublishedTopics } from "../data/topics";

// The numbers below are counted from the published content at build time
const publishedTopics = await getPublishedTopics();
const availableCourses = courses.filter((course) => course.isAvailable == true);
const resources = Object.values(await getCourseResources());
const totalInterviewQuestions = resources.reduce((sum, r) => sum + r.interviewQuestions, 0);
---

<MainLayout
    pageTitle = {`About Us - ${getSiteName()}`}
    description = {`${getSiteName()} publishes free, structured programming courses. Learn what the site covers, who writes it and how lessons are kept accurate.`}
    seoImagePath = ""
    pageType = "website"
>
    <!-- Hero Section -->
    <header class="pt-24 py-16 px-6 bg-gradient-to-br from-purple-50 to-blue-50 dark:from-gray-900 dark:to-gray-800 relative overflow-hidden">
        <div class="absolute top-0 right-0 w-64 h-64 bg-purple-300 dark:bg-purple-900 rounded-full -translate-y-32 translate-x-32 opacity-30 blur-3xl"></div>
        <div class="absolute bottom-0 left-0 w-64 h-64 bg-blue-300 dark:bg-blue-900 rounded-full translate-y-32 -translate-x-32 opacity-30 blur-3xl"></div>

        <div class="container mx-auto relative z-10">
            <div class="text-center max-w-4xl mx-auto animate-on-scroll">
                <h1 class="text-5xl md:text-6xl font-bold mb-6">
                    <span class="block">About</span>
                    <span class="gradient-text">{getSiteName()}</span>
                </h1>
                <p class="text-xl text-gray-600 dark:text-gray-300 max-w-3xl mx-auto">
                    {getSiteName()} is a free learning site for programmers. It publishes complete courses as short,
                    focused lessons, each with a working code example, so you can learn a technology from the basics to
                    expert topics in one place.
                </p>
            </div>
        </div>
    </header>

    <!-- Numbers -->
    <section class="py-12 px-6 bg-white dark:bg-gray-800">
        <div class="container mx-auto">
            <div class="grid grid-cols-1 sm:grid-cols-3 gap-6 max-w-4xl mx-auto text-center">
                <div class="rounded-2xl bg-gray-50 dark:bg-gray-900 p-6">
                    <div class="text-4xl font-bold gradient-text">{availableCourses.length}</div>
                    <p class="mt-2 text-gray-600 dark:text-gray-300">Courses</p>
                </div>
                <div class="rounded-2xl bg-gray-50 dark:bg-gray-900 p-6">
                    <div class="text-4xl font-bold gradient-text">{publishedTopics.length}</div>
                    <p class="mt-2 text-gray-600 dark:text-gray-300">Lessons</p>
                </div>
                <div class="rounded-2xl bg-gray-50 dark:bg-gray-900 p-6">
                    <div class="text-4xl font-bold gradient-text">{totalInterviewQuestions}</div>
                    <p class="mt-2 text-gray-600 dark:text-gray-300">Interview questions</p>
                </div>
            </div>
        </div>
    </section>

    <!-- What we publish / how -->
    <section class="py-16 px-6 bg-gray-50 dark:bg-gray-900">
        <div class="container mx-auto max-w-4xl space-y-12">
            <div class="animate-on-scroll">
                <h2 class="text-3xl font-bold mb-4">What You'll Find Here</h2>
                <ul class="space-y-3 text-gray-700 dark:text-gray-300">
                    <li><i class="fas fa-check-circle text-green-500 mr-2"></i><strong>Courses</strong> for languages, frameworks and tools such as {availableCourses.slice(0, 6).map((course) => course.courseTitle).join(", ")} and more. Each follows a syllabus grouped into Beginner, Intermediate, Advanced and Expert topics.</li>
                    <li><i class="fas fa-check-circle text-green-500 mr-2"></i><strong>Lessons</strong> that explain one idea at a time and end with a complete code listing you can copy and run.</li>
                    <li><i class="fas fa-check-circle text-green-500 mr-2"></i><strong>Interview questions</strong> with written answers, sorted by experience level.</li>
                    <li><i class="fas fa-check-circle text-green-500 mr-2"></i><strong>Blog posts</strong> about the site and about learning to program.</li>
                </ul>
            </div>

            <div class="animate-on-scroll">
                <h2 class="text-3xl font-bold mb-4">How Lessons Are Written</h2>
                <div class="space-y-4 text-gray-700 dark:text-gray-300">
                    <p>Every lesson names its author and shows when it was published and last updated. Lessons are written against the official documentation of the version they teach, and the code examples are meant to be run, not just read.</p>
                    <p>Technology moves quickly, so a lesson can fall behind a new release. When that happens we update the lesson and its "Last updated" date. If you find something wrong, please <a class="text-purple-600 dark:text-purple-400 hover:underline" href={GITHUB_ISSUES_URL} rel="noopener">open an issue on GitHub</a> and say which page it is on.</p>
                    <p>Our <a class="text-purple-600 dark:text-purple-400 hover:underline" href="/disclaimer">disclaimer</a> explains how to use the material safely, and the <a class="text-purple-600 dark:text-purple-400 hover:underline" href="/privacy-policy">privacy policy</a> explains what data the site and its advertising partners use.</p>
                </div>
            </div>

            <div class="animate-on-scroll">
                <h2 class="text-3xl font-bold mb-4">Free to Read</h2>
                <div class="space-y-4 text-gray-700 dark:text-gray-300">
                    <p>All courses are free and there is no account to create. The site is supported by advertising, which pays for the time that goes into writing and maintaining the lessons.</p>
                    <p>The source of the site is public on <a class="text-purple-600 dark:text-purple-400 hover:underline" href={GITHUB_REPO_URL} rel="noopener">GitHub</a>, and anyone can suggest a fix or a new topic. See <a class="text-purple-600 dark:text-purple-400 hover:underline" href="/contribute">how to contribute</a>.</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Authors -->
    <section id="team" class="py-16 px-6 bg-white dark:bg-gray-800">
        <div class="container mx-auto max-w-4xl">
            <div class="text-center mb-10 animate-on-scroll">
                <h2 class="text-3xl md:text-4xl font-bold mb-4">Who Writes <span class="gradient-text">{getSiteName()}</span></h2>
                <p class="text-gray-600 dark:text-gray-300">The people behind the lessons</p>
            </div>
            <div class="space-y-6">
                {
                    authors.map((author: any) => (
                        <AuthorCard
                            authorName = {author.authorName}
                            authorDesignation = {author.authorDesignation}
                            authorImage = {author.authorImageFileName}
                            authorBio = {author.bio}
                        />
                    ))
                }
            </div>
        </div>
    </section>

    <!-- CTA -->
    <section class="py-16 px-6 bg-gray-50 dark:bg-gray-900">
        <div class="container mx-auto max-w-3xl text-center">
            <h2 class="text-3xl md:text-4xl font-bold mb-6">Questions or <span class="gradient-text">Feedback?</span></h2>
            <p class="text-xl text-gray-600 dark:text-gray-300 mb-8">We read every message and every issue.</p>
            <div class="flex flex-col sm:flex-row justify-center gap-4">
                <a href="/contact" class="px-8 py-3 gradient-bg text-white font-medium rounded-full hover:opacity-90 transition-opacity shadow-lg">Contact Us</a>
                <a href="/courses" class="px-8 py-3 bg-white dark:bg-gray-800 border-2 border-gray-300 dark:border-gray-700 font-medium rounded-full hover:bg-gray-100 dark:hover:bg-gray-700 transition-colors">Browse Courses</a>
            </div>
        </div>
    </section>
</MainLayout>
