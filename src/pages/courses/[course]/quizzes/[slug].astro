---
import { getCollection } from 'astro:content';
import MainLayout from '../../../../layouts/MainLayout.astro';
import { courses } from '../../../../data/courses';

export async function getStaticPaths() {
    const quizzes = await getCollection('quizzes');
    return quizzes.filter((quiz) => quiz.data.isPublished).map((quiz) => ({
        params: { course: quiz.data.course, slug: quiz.data.slug },
        props: { quiz, courseData: courses.find((course) => course.slug === quiz.data.course) },
    }));
}

const { quiz, courseData } = Astro.props;
const questions = quiz.data.questions;
const totalPoints = questions.reduce((total, question) => total + question.points, 0);
const timeLimitSeconds = (quiz.data.timeLimitMinutes ?? 0) * 60;
---

<MainLayout
    pageTitle={`${quiz.data.title} - ${courseData?.courseTitle ?? 'Quiz'}`}
    description={quiz.data.description}
    seoImagePath=""
    pageType="website">
    <header class="relative overflow-hidden bg-linear-to-br from-purple-50 to-blue-50 px-6 py-10 dark:from-gray-900 dark:to-gray-800">
        <div class="absolute right-0 top-0 size-64 -translate-y-32 translate-x-32 rounded-full bg-purple-300 opacity-30 blur-3xl dark:bg-purple-900"></div>
        <div class="container relative z-10 mx-auto max-w-4xl text-center">
            <div class="mb-6 flex items-center justify-center gap-4">
                <div class="gradient-bg flex size-16 items-center justify-center rounded-2xl"><i class="fas fa-brain text-2xl text-white"></i></div>
                <div class="text-left"><h1 class="text-4xl font-bold md:text-5xl">{quiz.data.title}</h1><p class="text-gray-600 dark:text-gray-300">{quiz.data.description}</p></div>
            </div>
            <div class="flex flex-wrap justify-center gap-4 text-sm text-gray-600 dark:text-gray-300"><span class="capitalize"><i class="fas fa-layer-group mr-1"></i>{quiz.data.difficulty}</span><span><i class="fas fa-list-ol mr-1"></i>{questions.length} questions</span><span><i class:list={['fas', quiz.data.isTimed ? 'fa-clock' : 'fa-infinity', 'mr-1']}></i>{quiz.data.isTimed ? `${quiz.data.timeLimitMinutes} minute limit` : 'No time limit'}</span></div>
        </div>
    </header>

    <main class="container mx-auto max-w-7xl px-6 py-8">
        <div id="quiz-app" data-timed={quiz.data.isTimed ? 'true' : 'false'} data-time-limit={timeLimitSeconds}>
            <section id="start-screen" class="mx-auto max-w-3xl rounded-2xl bg-white p-8 text-center shadow-xl dark:bg-gray-800 md:p-12">
                <div class="gradient-bg mx-auto mb-6 flex size-20 items-center justify-center rounded-full"><i class="fas fa-play text-3xl text-white"></i></div>
                <h2 class="mb-3 text-3xl font-bold">Ready to begin?</h2>
                <p class="mb-8 text-gray-600 dark:text-gray-300">Review your answers before submitting. The quiz timer starts when you click Start Quiz.</p>
                <button id="start-quiz" class="rounded-lg gradient-bg px-8 py-3 font-semibold text-white shadow-lg transition hover:opacity-90"><i class="fas fa-play mr-2"></i>Start Quiz</button>
            </section>

            <div id="quiz-content" class="hidden flex-col gap-8 lg:flex-row">
                <aside class="lg:w-1/4">
                    <div class="sticky top-28 space-y-6">
                        <section class="rounded-2xl bg-white p-6 shadow-lg dark:bg-gray-800">
                            <h2 class="mb-4 text-lg font-bold">Quiz Progress</h2>
                            <div class="mb-5"><div class="mb-1 flex justify-between text-sm"><span>Completed</span><span id="completed-count">0/{questions.length}</span></div><div class="h-2 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700"><div id="quiz-progress" class="gradient-bg h-full transition-all" style="width: 0%"></div></div></div>
                            {quiz.data.isTimed && <div class="text-center text-sm text-gray-500 dark:text-gray-400"><i class="fas fa-hourglass-half mr-1"></i>Time is tracked while you attempt the quiz.</div>}
                            <button id="submit-quiz" class="mt-6 w-full rounded-lg gradient-bg px-4 py-3 font-medium text-white transition hover:opacity-90"><i class="fas fa-paper-plane mr-2"></i>Submit Quiz</button>
                            <button id="restart-quiz" class="mt-3 w-full rounded-lg border-2 border-gray-300 px-4 py-3 font-medium text-gray-700 transition hover:bg-gray-100 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-700"><i class="fas fa-redo mr-2"></i>Restart</button>
                        </section>
                        <section class="rounded-2xl bg-white p-6 shadow-lg dark:bg-gray-800"><h2 class="mb-4 text-lg font-bold">Questions</h2><div id="question-nav" class="grid grid-cols-5 gap-3"></div><div class="mt-5 space-y-2 border-t border-gray-200 pt-5 text-sm dark:border-gray-700"><div><i class="fas fa-circle mr-2 text-purple-500"></i>Current</div><div><i class="fas fa-circle mr-2 text-green-500"></i>Answered</div><div><i class="fas fa-circle mr-2 text-gray-300"></i>Unanswered</div></div></section>
                    </div>
                </aside>

                <div class="lg:w-3/4">
                    <section class="mb-8 rounded-2xl bg-white p-6 shadow-lg dark:bg-gray-800">
                        <div class="mb-4 flex items-center justify-between gap-4"><div><h2 class="text-xl font-bold">{quiz.data.isTimed ? 'Time Remaining' : 'Quiz Progress'}</h2><p class="text-sm text-gray-500 dark:text-gray-400">{quiz.data.isTimed ? 'Complete all questions before time runs out.' : 'Work through every question at your own pace.'}</p></div>{quiz.data.isTimed && <div id="timer" class="text-3xl font-bold gradient-text">{quiz.data.timeLimitMinutes}:00</div>}</div>
                        <div class="h-2 overflow-hidden rounded-full bg-gray-200 dark:bg-gray-700"><div id="timer-bar" class="gradient-bg h-full transition-all" style="width: 100%"></div></div>
                    </section>
                    <section id="question-container" class="rounded-2xl bg-white p-8 shadow-lg dark:bg-gray-800"></section>
                    <div class="mt-8 flex justify-between gap-4"><button id="prev-question" class="rounded-lg border-2 border-gray-300 px-6 py-3 font-medium text-gray-700 transition hover:bg-gray-100 disabled:cursor-not-allowed disabled:opacity-50 dark:border-gray-600 dark:text-gray-200 dark:hover:bg-gray-700" disabled><i class="fas fa-arrow-left mr-2"></i>Previous</button><button id="next-question" class="rounded-lg gradient-bg px-6 py-3 font-medium text-white transition hover:opacity-90">Next Question<i class="fas fa-arrow-right ml-2"></i></button></div>
                </div>
            </div>
        </div>

        <section id="result-modal" class="mx-auto mt-8 hidden max-w-3xl rounded-2xl bg-white p-8 text-center shadow-xl dark:bg-gray-800"><div class="gradient-bg mx-auto mb-4 flex size-20 items-center justify-center rounded-full"><i class="fas fa-trophy text-3xl text-white"></i></div><h2 class="mb-3 text-3xl font-bold">Quiz Complete!</h2><p id="result-summary" class="mb-8 text-lg text-gray-600 dark:text-gray-300"></p><div id="review" class="mb-8 space-y-4 text-left"></div><div class="flex flex-wrap justify-center gap-4"><button id="try-again" class="rounded-lg gradient-bg px-6 py-3 font-medium text-white"><i class="fas fa-redo mr-2"></i>Try Again</button><a href={`/courses/${quiz.data.course}/quizzes`} class="rounded-lg border-2 border-gray-300 px-6 py-3 font-medium dark:border-gray-600"><i class="fas fa-list mr-2"></i>All Quizzes</a></div></section>
    </main>
</MainLayout>

<script define:vars={{ questions, totalPoints, timeLimitSeconds }}>
    const app = document.getElementById('quiz-app');
    const startScreen = document.getElementById('start-screen');
    const quizContent = document.getElementById('quiz-content');
    const questionContainer = document.getElementById('question-container');
    const navContainer = document.getElementById('question-nav');
    const previousButton = document.getElementById('prev-question');
    const nextButton = document.getElementById('next-question');
    const answers = Array(questions.length).fill(null);
    let currentQuestion = 0;
    let started = false;
    let submitted = false;
    let remaining = timeLimitSeconds;
    let timerInterval;

    function score() { return answers.reduce((total, answer, index) => total + (answer === questions[index].correctAnswer ? questions[index].points : 0), 0); }
    function updateStats() {
        const answered = answers.filter((answer) => answer !== null).length;
        document.getElementById('completed-count').textContent = `${answered}/${questions.length}`;
        document.getElementById('quiz-progress').style.width = `${(answered / questions.length) * 100}%`;
        navContainer.querySelectorAll('button').forEach((button, index) => {
            button.classList.remove('gradient-bg', 'bg-green-500', 'bg-gray-200', 'dark:bg-gray-700', 'text-white');
            if (index === currentQuestion) {
                button.classList.add('gradient-bg', 'text-white');
            } else if (answers[index] !== null) {
                button.classList.add('bg-green-500', 'text-white');
            } else {
                button.classList.add('bg-gray-200', 'dark:bg-gray-700');
            }
        });
    }
    function renderQuestion() {
        const question = questions[currentQuestion];
        questionContainer.innerHTML = `<div class="mb-6"><span class="rounded-full bg-purple-100 px-3 py-1 text-sm font-medium text-purple-700 dark:bg-purple-900/40 dark:text-purple-300">Question ${currentQuestion + 1} of ${questions.length}</span></div><h2 class="mb-8 text-2xl font-bold">${question.question}</h2><div class="space-y-4">${question.options.map((option, index) => `<button type="button" class="quiz-option flex w-full items-center gap-3 rounded-xl border-2 border-gray-200 p-4 text-left transition hover:border-purple-400 dark:border-gray-600 ${answers[currentQuestion] === index ? 'border-purple-500 bg-purple-50 dark:bg-purple-900/30' : ''}" data-option="${index}" ${submitted ? 'disabled' : ''}><span class="flex size-8 shrink-0 items-center justify-center rounded-full border-2 border-current text-sm font-semibold">${String.fromCharCode(65 + index)}</span><span>${option}</span></button>`).join('')}</div>${submitted ? `<div class="mt-8 border-t border-gray-200 pt-6 dark:border-gray-700"><h3 class="mb-2 font-bold">Explanation</h3><p class="text-gray-600 dark:text-gray-300">${question.explanation || 'No explanation provided.'}</p><p class="mt-3 text-sm font-medium">Correct answer: ${question.options[question.correctAnswer]}</p></div>` : ''}`;
        questionContainer.querySelectorAll('.quiz-option').forEach((option) => option.addEventListener('click', () => { answers[currentQuestion] = Number(option.dataset.option); renderQuestion(); updateStats(); }));
        previousButton.disabled = currentQuestion === 0 || submitted;
        nextButton.disabled = submitted;
        nextButton.innerHTML = currentQuestion === questions.length - 1 ? 'Finish Quiz<i class="fas fa-flag-checkered ml-2"></i>' : 'Next Question<i class="fas fa-arrow-right ml-2"></i>';
        updateStats();
    }
    function renderNavigation() { navContainer.innerHTML = questions.map((_, index) => `<button type="button" class="flex size-10 items-center justify-center rounded-full bg-gray-200 font-semibold dark:bg-gray-700" data-index="${index}">${index + 1}</button>`).join(''); navContainer.querySelectorAll('button').forEach((button) => button.addEventListener('click', () => { if (!submitted) { currentQuestion = Number(button.dataset.index); renderQuestion(); } })); }
    function updateTimer() { const minutes = Math.floor(remaining / 60); const seconds = remaining % 60; document.getElementById('timer').textContent = `${String(minutes).padStart(2, '0')}:${String(seconds).padStart(2, '0')}`; document.getElementById('timer-bar').style.width = `${(remaining / timeLimitSeconds) * 100}%`; if (remaining <= 0) submitQuiz(); else remaining -= 1; }
    function submitQuiz() { if (submitted) return; submitted = true; clearInterval(timerInterval); const finalScore = score(); document.getElementById('result-summary').textContent = `You scored ${finalScore} out of ${totalPoints} points (${Math.round((finalScore / totalPoints) * 100)}%).`; document.getElementById('review').innerHTML = questions.map((question, index) => `<div class="rounded-xl border border-gray-200 p-4 dark:border-gray-700"><p class="font-semibold">${index + 1}. ${question.question}</p><p class="mt-1 text-sm ${answers[index] === question.correctAnswer ? 'text-green-600' : 'text-red-600'}">Your answer: ${answers[index] === null ? 'Not answered' : question.options[answers[index]]}</p></div>`).join(''); quizContent.classList.add('hidden'); quizContent.classList.remove('flex'); document.getElementById('result-modal').classList.remove('hidden'); renderQuestion(); }
    function startQuiz() { if (started) return; started = true; startScreen.classList.add('hidden'); quizContent.classList.remove('hidden'); quizContent.classList.add('flex'); renderNavigation(); renderQuestion(); if (app.dataset.timed === 'true') { updateTimer(); timerInterval = setInterval(updateTimer, 1000); } }
    document.getElementById('start-quiz').addEventListener('click', startQuiz);
    previousButton.addEventListener('click', () => { currentQuestion -= 1; renderQuestion(); });
    nextButton.addEventListener('click', () => currentQuestion === questions.length - 1 ? submitQuiz() : (currentQuestion += 1, renderQuestion()));
    document.getElementById('submit-quiz').addEventListener('click', submitQuiz);
    document.getElementById('restart-quiz').addEventListener('click', () => window.location.reload());
    document.getElementById('try-again').addEventListener('click', () => window.location.reload());
</script>
