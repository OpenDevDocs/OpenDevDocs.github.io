---
import { getCollection } from 'astro:content';
import MainLayout from '../../../../layouts/MainLayout.astro';
import { courses } from '../../../../data/courses';

export async function getStaticPaths() {
    const projects = await getCollection('projectIdeas');
    return projects.map((project) => ({
        params: { course: project.data.course, slug: project.data.slug },
        props: { project, courseData: courses.find((course) => course.slug === project.data.course) },
    }));
}

const { project, courseData } = Astro.props;
---

<MainLayout
    pageTitle={`${project.data.title} - ${courseData?.courseTitle ?? 'Project Idea'}`}
    description={project.data.description}
    seoImagePath={project.data.image ?? ''}
    pageType="website">
    <main class="container mx-auto max-w-5xl px-6 py-16">
        <a href={`/courses/${project.data.course}/project-ideas`} class="mb-8 inline-flex items-center text-purple-600 hover:underline dark:text-purple-400">
            <i class="fas fa-arrow-left mr-2"></i>Back to Project Ideas
        </a>
        <article class="overflow-hidden rounded-2xl bg-white shadow-xl dark:bg-gray-800">
            {project.data.image && <img src={project.data.image} alt={project.data.title} class="h-64 w-full object-cover md:h-96" />}
            <div class="p-6 md:p-10">
                <div class="mb-4 flex flex-wrap items-center gap-4 text-sm">
                    <span class="rounded-full bg-purple-100 px-3 py-1 font-semibold capitalize text-purple-700 dark:bg-purple-900/40 dark:text-purple-300">{project.data.difficulty}</span>
                    {project.data.estimatedTime && <span class="text-gray-500"><i class="far fa-clock mr-1"></i>{project.data.estimatedTime}</span>}
                </div>
                <h1 class="mb-4 text-4xl font-bold">{project.data.title}</h1>
                <p class="mb-8 text-lg text-gray-600 dark:text-gray-300">{project.data.description}</p>
                {project.data.topics.length > 0 && <section class="mb-8"><h2 class="mb-3 text-xl font-bold">Topics to Implement</h2><div class="flex flex-wrap gap-2">{project.data.topics.map((topic) => <span class="rounded-md bg-purple-50 px-3 py-1 text-sm text-purple-700 dark:bg-purple-900/30 dark:text-purple-300">{topic}</span>)}</div></section>}
                {project.data.features.length > 0 && <section class="mb-8"><h2 class="mb-3 text-xl font-bold">Key Features</h2><ul class="space-y-2 text-gray-600 dark:text-gray-300">{project.data.features.map((feature) => <li><i class="fas fa-check-circle mr-2 text-green-500"></i>{feature}</li>)}</ul></section>}
                {project.data.technologies.length > 0 && <section><h2 class="mb-3 text-xl font-bold">Technologies</h2><p class="text-gray-600 dark:text-gray-300">{project.data.technologies.join(', ')}</p></section>}
            </div>
        </article>
    </main>
</MainLayout>