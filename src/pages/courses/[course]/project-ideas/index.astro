---
import { getCollection } from 'astro:content';
import MainLayout from '../../../../layouts/MainLayout.astro';
import { courses } from '../../../../data/courses';

const difficultyLevels = [
    { id: 'beginner', label: 'Beginner', icon: 'fa-seedling', color: 'green' },
    { id: 'intermediate', label: 'Intermediate', icon: 'fa-chart-line', color: 'yellow' },
    { id: 'advanced', label: 'Advanced', icon: 'fa-rocket', color: 'red' },
] as const;

export function getStaticPaths() {
    return courses.map((course) => ({
        params: { course: course.slug },
        props: { courseData: course },
    }));
}

const { course } = Astro.params;
const { courseData } = Astro.props;
const projects = (await getCollection('projectIdeas'))
    .filter((project) => project.data.course === course && project.data.isPublished)
    .sort((a, b) => a.data.title.localeCompare(b.data.title));
const projectsByDifficulty = Object.fromEntries(
    difficultyLevels.map((level) => [level.id, projects.filter((project) => project.data.difficulty === level.id)])
) as Record<typeof difficultyLevels[number]['id'], typeof projects>;
---

<MainLayout
    pageTitle={`Project Ideas for ${courseData.courseTitle}`}
    description={`Build ${courseData.courseTitle} projects for your portfolio.`}
    seoImagePath=""
    pageType="website">
    <header class="relative overflow-hidden bg-linear-to-br from-purple-50 to-blue-50 px-6 py-20 dark:from-gray-900 dark:to-gray-800">
        <div class="container relative z-10 mx-auto max-w-4xl text-center">
            <div class="mb-6 flex justify-center">
                <div class="gradient-bg flex size-20 items-center justify-center rounded-2xl">
                    <i class="fas fa-lightbulb text-3xl text-white"></i>
                </div>
            </div>
            <h1 class="mb-4 text-4xl font-bold md:text-5xl">{courseData.courseTitle} Project Ideas</h1>
            <p class="mb-8 text-xl text-gray-600 dark:text-gray-300">Build practical projects and strengthen your {courseData.courseTitle} skills.</p>
            <div class="grid grid-cols-2 gap-4 md:grid-cols-4">
                <div class="rounded-xl bg-white p-4 shadow-lg dark:bg-gray-800">
                    <div class="gradient-text text-2xl font-bold">{projects.length}</div>
                    <div class="text-sm text-gray-600 dark:text-gray-300">Total Projects</div>
                </div>
                {difficultyLevels.map((level) => (
                    <div class="rounded-xl bg-white p-4 shadow-lg dark:bg-gray-800">
                        <div class:list={[`text-${level.color}-600`, `dark:text-${level.color}-400`, 'text-2xl font-bold']}>
                            {projectsByDifficulty[level.id].length}
                        </div>
                        <div class="text-sm text-gray-600 dark:text-gray-300">{level.label}</div>
                    </div>
                ))}
            </div>
        </div>
    </header>

    <main class="container mx-auto max-w-7xl px-6 py-12">
        <div class="mb-10 flex flex-wrap justify-center gap-3">
            <button class="project-filter rounded-full gradient-bg px-5 py-2 font-medium text-white" data-filter="all">All Projects</button>
            {difficultyLevels.map((level) => (
                <button class="project-filter rounded-full bg-gray-100 px-5 py-2 font-medium text-gray-700 dark:bg-gray-800 dark:text-gray-200" data-filter={level.id}>{level.label}</button>
            ))}
        </div>

        <div class="space-y-16">
            {difficultyLevels.map((level) => (
                <section id={level.id} class="project-section">
                    <div class="mb-6 flex items-center gap-4">
                        <div class:list={[`bg-${level.color}-100`, `dark:bg-${level.color}-900`, 'flex size-12 items-center justify-center rounded-xl']}>
                            <i class:list={[`text-${level.color}-600`, `dark:text-${level.color}-400`, 'fas', level.icon, 'text-xl']}></i>
                        </div>
                        <div>
                            <h2 class="text-3xl font-bold">{level.label} Projects</h2>
                            <p class="text-gray-600 dark:text-gray-300">{projectsByDifficulty[level.id].length} project{projectsByDifficulty[level.id].length === 1 ? '' : 's'} to explore</p>
                        </div>
                    </div>

                    {projectsByDifficulty[level.id].length > 0 ? (
                        <div class="grid gap-8 md:grid-cols-2 lg:grid-cols-3">
                            {projectsByDifficulty[level.id].map((project) => (
                                <article class="group flex h-full flex-col overflow-hidden rounded-2xl bg-white shadow-lg transition duration-300 hover:-translate-y-2 hover:shadow-2xl dark:bg-gray-800">
                                    <div class="relative h-48 overflow-hidden bg-gray-200 dark:bg-gray-700">
                                        {project.data.image ? <img src={project.data.image} alt={project.data.title} class="h-full w-full object-cover transition duration-500 group-hover:scale-110" loading="lazy" /> : <div class="flex h-full items-center justify-center"><i class="fas fa-lightbulb text-4xl text-gray-400"></i></div>}
                                        <div class="absolute inset-0 bg-linear-to-t from-black/60 to-transparent"></div>
                                        <span class="absolute right-4 top-4 rounded-full bg-white/90 px-3 py-1 text-xs font-semibold capitalize text-gray-800">{level.label}</span>
                                        {project.data.estimatedTime && <span class="absolute bottom-4 left-4 rounded-full bg-black/50 px-3 py-1 text-sm font-medium text-white"><i class="far fa-clock mr-1"></i>{project.data.estimatedTime}</span>}
                                    </div>
                                    <div class="flex flex-1 flex-col p-6">
                                        <h3 class="mb-3 text-xl font-bold transition-colors group-hover:text-purple-600 dark:group-hover:text-purple-400">{project.data.title}</h3>
                                        <p class="mb-4 flex-1 text-gray-600 dark:text-gray-300">{project.data.description}</p>
                                        {project.data.topics.length > 0 && <div class="mb-6 flex flex-wrap gap-2">{project.data.topics.map((topic) => <span class="rounded-md bg-purple-50 px-3 py-1 text-xs text-purple-700 dark:bg-purple-900/30 dark:text-purple-300">{topic}</span>)}</div>}
                                        <div class="flex items-center justify-between border-t border-gray-200 pt-4 dark:border-gray-700">
                                            <span class="text-sm text-gray-600 dark:text-gray-300"><i class="fas fa-tools mr-2 text-gray-400"></i>{project.data.technologies.length} tech{project.data.technologies.length === 1 ? '' : 's'}</span>
                                            <a href={`/courses/${course}/project-ideas/${project.data.slug}`} class="rounded-lg gradient-bg px-4 py-2 text-sm text-white transition hover:opacity-90">View Details</a>
                                        </div>
                                    </div>
                                </article>
                            ))}
                        </div>
                    ) : (
                        <p class="rounded-xl border border-dashed border-gray-300 p-8 text-center text-gray-500 dark:border-gray-700">No {level.label.toLowerCase()} projects have been published yet.</p>
                    )}
                </section>
            ))}
        </div>
    </main>
</MainLayout>

<script is:inline>
    document.querySelectorAll('.project-filter').forEach((button) => {
        button.addEventListener('click', () => {
            const filter = button.dataset.filter;
            document.querySelectorAll('.project-filter').forEach((item) => item.classList.remove('gradient-bg', 'text-white'));
            button.classList.add('gradient-bg', 'text-white');
            document.querySelectorAll('.project-section').forEach((section) => {
                section.classList.toggle('hidden', filter !== 'all' && section.id !== filter);
            });
        });
    });
</script>
