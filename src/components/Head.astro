---
import { SEO } from 'astro-seo';
import { ADSENSE_CLIENT_ID } from '../data/data';

interface Props {
    pageTitle ?: string
    description : string,
    seoImagePath : string,
    pageType ?: string,
    // Error and utility pages have no publisher content, so AdSense policy says no ads there
    noAds ?: boolean,
    noIndex ?: boolean
}

const {pageTitle = "", pageType = "website", description, seoImagePath, noAds = false, noIndex = false} = Astro.props;

// Social previews need an absolute image URL; fall back to the site icon
const ogImage = new URL(seoImagePath || "/android-chrome-512x512.png", Astro.site).href;
const showAds = ADSENSE_CLIENT_ID !== "" && !noAds;
---

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <SEO
      title={pageTitle}
      description={description || undefined}
      noindex={noIndex}
      openGraph={{
        basic: {
          title: pageTitle,
          type: pageType,
          image: ogImage,
        },
        optional: {
          description: description || undefined,
          siteName: "Open Dev Docs",
        }
      }}
      extend={{
        // extending the default link tags
        link: [{ rel: "icon", href: "/favicon.ico" }],
        // extending the default meta tags
        meta: [
          { name: "twitter:card", content: "summary" },
          { name: "twitter:image", content: ogImage },
          { name: "twitter:title", content: pageTitle },
          ...(description ? [{ name: "twitter:description", content: description }] : []),
        ],
      }}
    />

    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
    <link rel="manifest" href="/site.webmanifest">
    <meta name="theme-color" media="(prefers-color-scheme: light)" content="#f9fafb">
    <meta name="theme-color" media="(prefers-color-scheme: dark)" content="#111827">

    {ADSENSE_CLIENT_ID && <meta name="google-adsense-account" content={ADSENSE_CLIENT_ID}>}
    {showAds && (
        <script
            is:inline
            async
            src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${ADSENSE_CLIENT_ID}`}
            crossorigin="anonymous"
        ></script>
    )}

    <slot />

</head>
