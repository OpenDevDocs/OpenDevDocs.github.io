---
import { getSiteName } from "../data/data";


---

<!-- Navigation -->
<nav class="sticky top-0 w-full z-50 bg-white/90 dark:bg-gray-900/90 backdrop-blur-md shadow-sm">
    <div class="container mx-auto px-6 py-4">
        <div class="flex justify-between items-center">
            <div class="flex items-center space-x-2">
                <div class="gradient-bg w-8 h-8 rounded-lg flex items-center justify-center">
                    <i class="fas fa-code text-white"></i>
                </div>
                <a href="/" class="text-2xl font-bold gradient-text">{getSiteName()}</a>
            </div>

            <div class="hidden md:flex space-x-8">
                <a href="/courses"
                    class="font-medium hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Courses</a>
                <a href="/interview-prep"
                    class="font-medium hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Interview Prep</a>
                <a href="/blog"
                    class="font-medium hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Blog</a>
                <a href="/authors"
                    class="font-medium hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Our Authors</a>
                <a href="/about"
                    class="font-medium hover:text-purple-600 dark:hover:text-purple-400 transition-colors">About</a>
            </div>

            <div class="flex items-center space-x-4">
                <button type="button" data-search-open aria-label="Search"
                    class="flex items-center gap-2 h-10 px-3 rounded-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 text-gray-500 dark:text-gray-400 transition-colors">
                    <i class="fas fa-search"></i>
                    <span class="hidden lg:inline text-sm">Search</span>
                    <kbd class="hidden lg:inline text-xs font-sans px-1.5 py-0.5 rounded border border-gray-300 dark:border-gray-600">Ctrl K</kbd>
                </button>
                <button id="theme-toggle" aria-label="Toggle dark mode"
                    class="size-10 p-2 rounded-full bg-gray-100 dark:bg-gray-800 hover:bg-gray-200 dark:hover:bg-gray-700 transition-colors">
                    <i class="fas fa-moon text-gray-800 dark:text-yellow-400"></i>
                </button>
                <button id="mobile-menu-button" aria-label="Open menu" class="md:hidden p-2 rounded-lg bg-gray-100 dark:bg-gray-800">
                    <i class="fas fa-bars"></i>
                </button>
            </div>
        </div>

        <!-- Mobile Menu -->
        <div id="mobile-menu" class="hidden md:hidden mt-4 pb-4 border-t border-gray-200 dark:border-gray-700">
            <div class="flex flex-col space-y-4 mt-4">
                <a href="/courses"
                    class="font-medium hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Courses</a>
                <a href="/interview-prep"
                    class="font-medium hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Interview Prep</a>
                <a href="/blog"
                    class="font-medium hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Blog</a>
                <a href="/authors"
                    class="font-medium hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Our Authors</a>
                <a href="/about"
                    class="font-medium hover:text-purple-600 dark:hover:text-purple-400 transition-colors">About</a>
                <a href="/contact"
                    class="font-medium hover:text-purple-600 dark:hover:text-purple-400 transition-colors">Contact</a>
            </div>
        </div>
    </div>
</nav>